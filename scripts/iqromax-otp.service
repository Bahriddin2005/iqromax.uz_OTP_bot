[Unit]
Description=iqromax.uz OTP Verification Bot
Documentation=https://github.com/iqromax/otp-bot
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/iqromax-otp-bot
Environment=PYTHONPATH=/opt/iqromax-otp-bot
EnvironmentFile=/opt/iqromax-otp-bot/.env
ExecStart=/opt/iqromax-otp-bot/venv/bin/python main.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=append:/var/log/iqromax-otp/app.log
StandardError=append:/var/log/iqromax-otp/error.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/iqromax-otp-bot/logs /var/log/iqromax-otp

[Install]
WantedBy=multi-user.target
