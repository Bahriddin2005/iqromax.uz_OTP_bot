# iqromax.uz OTP Bot - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# APPLICATION
# ===========================================
APP_NAME="iqromax.uz OTP Bot"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# ===========================================
# TELEGRAM BOT
# ===========================================
# Get this from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: For webhook mode in production
TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook/telegram
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# DATABASE - Supabase (PostgreSQL)
# ===========================================
# Use Supabase connection string from: Project Settings → Database
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ===========================================
# SUPABASE (when using Supabase instead of local PostgreSQL)
# ===========================================
# Set USE_SUPABASE=1 when DATABASE_URL points to Supabase
USE_SUPABASE=0

# Project URL: Project Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
# Service role key (secret, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ===========================================
# REDIS
# ===========================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ===========================================
# OTP SETTINGS
# ===========================================
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=3
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_MINUTES=1
OTP_MAX_REQUESTS_PER_HOUR=5

# ===========================================
# SECURITY
# ===========================================
# Generate a strong secret key for production
API_SECRET_KEY=your-super-secret-api-key-change-this

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://iqromax.uz,https://www.iqromax.uz

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# ===========================================
# ADMIN
# ===========================================
# Comma-separated list of admin Telegram IDs
ADMIN_TELEGRAM_IDS=123456789,987654321

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ===========================================
# SERVER
# ===========================================
HOST=0.0.0.0
PORT=8000
